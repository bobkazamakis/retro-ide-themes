        {
            "name": "Comment",
            "scope": "comment, punctuation.definition.comment",
            "foreground": "var(comment)"
        },
        {
            "name": "Documentation comment",
            "scope": "comment.block.documentation, comment.line.documentation, comment.block.documentation.swift, comment.line.documentation.swift",
            "foreground": "var(doc)"
        },
        {
            "name": "Documentation keyword (- Parameter, - Returns)",
            "scope": "comment keyword, comment.block.documentation keyword, comment.block.documentation variable.parameter, comment entity.name, comment markup.bold",
            "foreground": "var(doc_key)",
            "font_style": "bold"
        },
        {
            "name": "TODO / FIXME / MARK",
            "scope": "comment keyword.codetag, comment keyword.other.mark, comment keyword.other.documentation, comment.line.double-slash keyword.codetag, keyword.codetag",
            "foreground": "var(codetag)",
            "font_style": "bold"
        },
        {
            "name": "Shebang",
            "scope": "comment.line.number-sign.shebang, punctuation.definition.comment.shebang",
            "foreground": "var(preproc)"
        },
        // ---------- Strings -------------------------------------------------------
