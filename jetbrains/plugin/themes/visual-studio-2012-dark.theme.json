        "background": "tool-window-bg",
        "inactiveBackground": "tool-window-bg",
        "borderColor": "tool-window-border"
      },
      "Stripe": {
        "background": "main-window-bg",
        "borderColor": "transparent",
        "separatorColor": "toolbar-border"
      }
