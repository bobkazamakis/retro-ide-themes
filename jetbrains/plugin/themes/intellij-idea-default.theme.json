    "inlay-bg": "#F7F7F7",
    "inlay-border": "#CFD3DE",
    "editor-floating-toolbar-bg": "#FFFFFF",
    "search-match-bg": "#FFEB99",
    "tree-indent-guide-border": "#DEE1E9",
    "icon-default-stroke": "#535966",
    "icon-over-accent": "#FFFFFF",
    "icon-green-stroke": "#236636"
