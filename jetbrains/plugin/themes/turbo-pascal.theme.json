    "ColorPalette": {
      "Actions.Blue": "#54FCFC",
      "Actions.Green": "#54FC54",
      "Actions.Red": "#FC5454",
      "Actions.Yellow": "#FCFC54",
      "Objects.Blue": "#54FCFC",
      "Objects.Green": "#54FC54",
      "Objects.Purple": "#FC54FC",
      "Objects.Red": "#FC5454",
      "Objects.Yellow": "#FCFC54"
